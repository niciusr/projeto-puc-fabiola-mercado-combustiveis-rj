# Dados baixados e resultados de execução não entram no repositório.
data/raw/*
data/processed/*
data/metadata/*.json
data/metadata/*.csv

!data/README.md
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/metadata/.gitkeep

# Arquivos locais do Databricks e do Python.
.databricks/
__pycache__/
*.pyc
.DS_Store

# Credenciais, certificados e configurações específicas da máquina.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
.vscode/
.idea/
.ipynb_checkpoints/

# Artefatos temporários de validação e versões intermediárias do relatório.
tmp/
output/pdf/*.pdf
!output/pdf/relatorio_puc_fabiola_anp_brasil_final.pdf
!output/pdf/relatorio_puc_fabiola_anp_brasil_revisado.pdf
